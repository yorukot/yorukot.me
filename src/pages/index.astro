---
import IcBaselineDiscord from '~icons/ic/baseline-discord';
import IcSharpEmail from '~icons/ic/sharp-email';
import MdiArrowTopRight from '~icons/mdi/arrow-top-right';
import MdiGithub from '~icons/mdi/github';
import MdiHeart from '~icons/mdi/heart';
import MdiTelegram from '~icons/mdi/telegram';
import BoidsBackground from '../components/BoidsBackground.astro';
import { Content as AboutContent } from '../data/about.md';
import { contact } from '../data/contact';
import { site } from '../data/site';
import { work } from '../data/work';
import { getPublishedBlogPosts } from '../data/blog';
import Layout from '../layouts/Layout.astro';
import { absoluteAssetUrl, absoluteUrl, blogPostPath } from '../lib/seo';

const contactIconMap = {
    Email: IcSharpEmail,
    GitHub: MdiGithub,
    Discord: IcBaselineDiscord,
    Telegram: MdiTelegram,
    Donate: MdiHeart,
};

type WorkItem = Omit<(typeof work.work)[number], 'href'> & { href?: string };
type ContactChannel = { label: keyof typeof contactIconMap; href: string; value: string };

const sideChannels: ContactChannel[] = [
    ...contact.channels.filter((item) => item.label !== 'Email'),
    contact.donate,
];
type BlogPost = Awaited<ReturnType<typeof getPublishedBlogPosts>>[number];

const featuredPosts: BlogPost[] = (await getPublishedBlogPosts())
    .filter((post: BlogPost) => post.data.featured)
    .sort((a: BlogPost, b: BlogPost) => b.data.publish_date.getTime() - a.data.publish_date.getTime())
    .slice(0, 3);

const formatDate = (date: Date) =>
    new Intl.DateTimeFormat('en', {
        year: 'numeric',
        month: 'short',
        day: '2-digit',
    }).format(date);

const homeJsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: absoluteUrl('/'),
        description: site.description,
        inLanguage: site.language,
        publisher: {
            '@type': 'Person',
            name: site.author,
            url: absoluteUrl('/'),
        },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.author,
        url: absoluteUrl('/'),
        email: site.email,
        image: absoluteAssetUrl(site.defaultOgImage),
        sameAs: [
            site.social.github,
            site.social.telegram,
            site.social.kofi,
        ],
        knowsAbout: ['Open source', 'CLI', 'TUI', 'Backend development', 'Full-stack web'],
    },
];
const homeTitle = 'Yorukot | Open-Source Developer';
---

<Layout
    title={homeTitle}
    description={site.description}
    canonicalPath="/"
    image={site.defaultOgImage}
    imageAlt="Yorukot open-source developer social image"
    jsonLd={homeJsonLd}
>
    <section class="hero-section relative isolate overflow-hidden px-6 py-8 sm:px-10 sm:py-10">
        <BoidsBackground />

        <div class="hero-content relative z-10 flex items-center justify-center">
            <div class="w-full max-w-2xl py-12 sm:py-16">
                <h1 class="sr-only">{site.author}</h1>
                <div class="about-prose text-lg leading-8 text-text/80" data-boids-avoid>
                    <AboutContent />
                </div>
            </div>
        </div>
    </section>

    <section class="border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="my-work" data-reveal-section>
        <div class="home-content space-y-12">
            <div class="max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>{work.heading}</span>
                </h2>
            </div>

            <div class="space-y-8 text-text">
                <div class="work-list-frame grid border-y border-border bg-background">
                    {work.work.map((item: WorkItem) => (
                        <article class="work-reveal-row bg-background text-text" data-work-reveal>
                            <div class="space-y-4 px-0 py-5 sm:px-5">
                                <div class="font-mono text-sm text-primary">
                                    {item.id}
                                </div>

                                <div class="flex flex-wrap items-center gap-3">
                                    <h3 class="text-xl font-bold text-text">
                                        {item.href ? (
                                            <a
                                                class="group inline-flex items-center gap-2 underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary focus-visible:text-primary focus-visible:decoration-primary focus-visible:outline-none"
                                                href={item.href}
                                                target={item.href.startsWith('http') ? '_blank' : undefined}
                                                rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                                            >
                                                <span>{item.title}</span>
                                                <MdiArrowTopRight
                                                    class="shrink-0 text-base text-primary transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-focus-visible:-translate-y-0.5 group-focus-visible:translate-x-0.5"
                                                    aria-hidden="true"
                                                />
                                            </a>
                                        ) : (
                                            item.title
                                        )}
                                    </h3>
                                </div>
                            </div>

                            <div class="px-0 pb-5 sm:px-5">
                                <p class="text-base leading-7 text-text/70">
                                    {item.description}
                                </p>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <section class="border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="blog" data-reveal-section>
        <div class="home-content space-y-12">
            <div class="max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>BLOG</span>
                </h2>
            </div>

            <div class="space-y-8 text-text">
                <p class="text-lg leading-8 text-text/80">
                    I write about anything I find interesting, no matter what it is.
                </p>

                {
                    featuredPosts.length > 0 && (
                        <div class="border-y border-border">
                            {featuredPosts.map((post: BlogPost) => (
                                <article class="blog-preview-item border-t border-border py-8 first:border-t-0">
                                    <div class="space-y-4">
                                        <div class="flex flex-wrap items-center gap-3 font-mono text-sm uppercase tracking-[0.12em] text-text/60">
                                            <time class="text-primary" datetime={post.data.publish_date.toISOString()}>
                                                {formatDate(post.data.publish_date)}
                                            </time>
                                        </div>

                                        <h3 class="text-xl font-bold leading-tight text-text sm:text-2xl">
                                            <a
                                                class="underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary focus-visible:text-primary focus-visible:decoration-primary focus-visible:outline-none"
                                                href={blogPostPath(post.data.post_slug)}
                                            >
                                                {post.data.title}
                                            </a>
                                        </h3>

                                        <p class="text-base leading-7 text-text/70">
                                            {post.data.description}
                                        </p>
                                    </div>
                                </article>
                            ))}
                        </div>
                    )
                }

                <a
                    class="about-blog-link inline-flex border border-border px-4 py-3 font-mono text-sm uppercase tracking-[0.14em] text-primary no-underline transition-colors hover:border-primary hover:bg-primary hover:text-background focus-visible:border-primary focus-visible:bg-primary focus-visible:text-background focus-visible:outline-none"
                    href="/blog/"
                >
                    {featuredPosts.length > 0 ? 'More from blog' : 'Go to blog'}
                </a>

            </div>
        </div>
    </section>

    <section class="border-t border-border px-6 py-20 sm:px-10 sm:py-24" id="contact" data-reveal-section>
        <div class="home-content space-y-12">
            <div class="max-w-sm">
                <h2
                    class="about-reveal about-reveal-heading text-5xl uppercase text-text font-bold"
                    data-section-reveal
                >
                    <span>{contact.heading}</span>
                </h2>
            </div>

            <div class="space-y-8 text-text">
                <div class="grid gap-px border-y border-border bg-border lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)]">
                    <a
                        class="email-panel group relative isolate grid min-h-72 overflow-hidden bg-background p-6 text-text no-underline transition-colors focus-visible:outline-none sm:p-8"
                        href={contact.email.href}
                    >
                        <span class="email-panel-logo" aria-hidden="true">
                            <IcSharpEmail />
                        </span>

                        <div class="relative z-10 space-y-5">
                            <h3 class="max-w-xl text-4xl font-bold uppercase text-current transition-colors sm:text-5xl">
                                {contact.email.title}
                            </h3>
                            <p class="max-w-md text-base leading-7 text-text/70 transition-colors group-hover:text-background/70 group-focus-visible:text-background/70">
                                {contact.email.note}
                            </p>
                            <div class="inline-flex border border-border px-3 py-2 font-mono text-sm text-primary transition-colors group-hover:border-background group-hover:text-background group-focus-visible:border-background group-focus-visible:text-background">
                                {contact.email.value}
                            </div>
                        </div>
                    </a>

                    <div class="grid gap-px bg-border">
                        {sideChannels.map((item: ContactChannel) => {
                            const Icon = contactIconMap[item.label];

                            return (
                                <a
                                    class="contact-channel group relative isolate overflow-hidden bg-background p-5 text-text no-underline transition-colors focus-visible:outline-none sm:p-6"
                                    href={item.href}
                                    target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                                    rel={item.href.startsWith('mailto:') ? undefined : 'noreferrer'}
                                >
                                    <span class="contact-channel-logo" aria-hidden="true">
                                        <Icon />
                                    </span>

                                    <div class="relative z-10 flex items-center justify-between gap-6">
                                        <div class="flex flex-wrap items-center gap-3">
                                            <h3 class="text-xl font-bold text-current transition-colors">
                                                {item.label}
                                            </h3>
                                            <span class="font-mono text-sm text-primary transition-colors group-hover:text-background group-focus-visible:text-background">
                                                {item.value}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .about-prose {
        font-family: Georgia, "Times New Roman", serif;
    }

    .about-prose > :global(* + *) {
        margin-top: 1.25rem;
    }

    .about-prose :global(blockquote) {
        border-left: 2px solid var(--color-primary);
        padding-left: 1rem;
        color: var(--color-text);
        font-style: italic;
    }

    .about-prose :global(strong) {
        color: var(--color-text);
        font-weight: 700;
    }

    .about-prose :global(a) {
        color: var(--color-primary);
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 4px;
        transition: text-decoration-color 200ms ease-out;
    }

    .about-prose :global(a:hover),
    .about-prose :global(a:focus-visible) {
        text-decoration-color: var(--color-primary);
        outline: none;
    }

    .about-prose :global(ul) {
        list-style: none;
        padding: 0;
    }

    .about-prose :global(li) {
        display: flex;
        gap: 0.75rem;
    }

    .about-prose :global(ul) {
        display: grid;
        row-gap: 0.25rem;
        column-gap: 2rem;
    }

    @media (min-width: 640px) {
        .about-prose :global(ul) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .about-prose :global(li)::before {
        content: "›";
        color: var(--color-primary);
        font-family: ui-monospace, monospace;
    }

    .home-content {
        width: 100%;
        max-width: 56rem;
        margin-inline: auto;
    }

    .hero-section {
        --boids-opacity: 0.25;
        min-height: calc(100vh - 4rem);
    }

    .hero-content {
        min-height: calc(100vh - 9.5rem);
    }

    @media (min-width: 800px) {
        .hero-section {
            min-height: calc(100vh - 6.5rem);
        }

        .hero-content {
            min-height: calc(100vh - 12rem);
        }
    }

    .email-panel:hover,
    .email-panel:focus-visible {
        background: var(--color-text);
        color: var(--color-background);
    }

    .email-panel-logo {
        position: absolute;
        right: 1.5rem;
        bottom: -1rem;
        z-index: 0;
        color: var(--color-background);
        font-size: 12rem;
        line-height: 1;
        opacity: 0;
        pointer-events: none;
        transform: translateX(1rem) rotate(-8deg);
        transition:
            opacity 420ms ease-out,
            transform 420ms ease-out;
        mask-image: linear-gradient(90deg, transparent 0%, black 100%);
        -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 100%);
    }

    .email-panel:hover .email-panel-logo,
    .email-panel:focus-visible .email-panel-logo {
        opacity: 0.16;
        transform: translateX(0) rotate(-8deg);
    }

    .contact-channel-logo {
        position: absolute;
        top: 50%;
        right: 1.5rem;
        z-index: 0;
        color: var(--color-background);
        font-size: 7rem;
        line-height: 1;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-50%);
        transition:
            opacity 420ms ease-out,
            transform 420ms ease-out;
        mask-image: linear-gradient(90deg, transparent 0%, black 100%);
        -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 100%);
    }

    .contact-channel:hover,
    .contact-channel:focus-visible {
        background: var(--color-text);
        color: var(--color-background);
    }

    .contact-channel:hover .contact-channel-logo,
    .contact-channel:focus-visible .contact-channel-logo {
        opacity: 0.18;
        transform: translateY(-50%) translateX(-0.25rem);
    }

    .about-reveal {
        position: relative;
        display: block;
        overflow: hidden;
        color: var(--color-text);
        transition: color 300ms ease-out var(--about-reveal-delay, 0ms);
    }

    .about-reveal::before {
        content: "";
        position: absolute;
        inset: 0;
        transform: scaleX(0);
        transform-origin: left;
        background: var(--color-text);
        transition: transform 520ms ease-out var(--about-reveal-delay, 0ms);
    }

    .about-reveal > span {
        position: relative;
        z-index: 1;
    }

    .about-reveal-heading {
        width: fit-content;
        padding: 0.08em 0.14em;
        margin-inline: -0.14em;
    }

    .about-reveal.is-visible {
        color: var(--color-background);
    }

    .about-reveal.is-visible::before {
        transform: scaleX(1);
    }

    .work-reveal-row {
        border-top: 1px solid var(--color-border);
        opacity: 0;
        transform: translateX(2rem);
        transition:
            background 180ms ease-out,
            border-color 180ms ease-out;
    }

    .work-reveal-row:hover,
    .work-reveal-row:focus-within {
        border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
        background:
            radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary) 18%, transparent), transparent 24rem),
            var(--color-background);
    }

    .work-list-frame {
        overflow-x: hidden;
        overflow-x: clip;
    }

    .work-reveal-row:first-child {
        border-top: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .about-reveal,
        .about-reveal::before {
            transition-duration: 0ms;
            transition-delay: 0ms;
        }

        .work-reveal-row {
            opacity: 1;
            transform: none;
        }
    }
</style>

<script>
    import { animate, onScroll } from 'animejs';

    const revealSections = document.querySelectorAll('[data-reveal-section]');
    const workRevealItems = document.querySelectorAll('[data-work-reveal]');

    revealSections.forEach((section) => {
        const revealItems = section.querySelectorAll('[data-section-reveal]');

        if (!(section instanceof HTMLElement) || !revealItems.length) {
            return;
        }

        const showRevealItems = () => {
            revealItems.forEach((item) => {
                item.classList.add('is-visible');
            });
        };

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            showRevealItems();
        } else if ('IntersectionObserver' in window) {
            const revealObserver = new IntersectionObserver(
                (entries) => {
                    if (entries.some((entry) => entry.isIntersecting)) {
                        showRevealItems();
                        revealObserver.disconnect();
                    }
                },
                {
                    threshold: 0.35,
                },
            );

            revealObserver.observe(section);
        } else {
            showRevealItems();
        }
    });

    if (workRevealItems.length) {
        const showWorkRevealItem = (item: Element) => {
            if (!(item instanceof HTMLElement)) {
                return;
            }

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                item.style.opacity = '1';
                item.style.transform = 'translateX(0rem)';
                return;
            }

            animate(item, {
                x: ['3rem', '0rem'],
                opacity: 1,
                duration: 360,
                ease: 'out(3)',
            });
        };

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            workRevealItems.forEach(showWorkRevealItem);
        } else {
            workRevealItems.forEach((item) => {
                if (!(item instanceof HTMLElement)) {
                    return;
                }

                animate(item, {
                    x: ['3rem', '0rem'],
                    opacity: 1,
                    duration: 360,
                    ease: 'out(3)',
                    autoplay: onScroll({
                        target: item,
                        enter: { target: 'top', container: '60%' },
                        leave: { target: 'bottom', container: 'top' },
                        repeat: false,
                    }),
                });
            });
        }
    }
</script>
